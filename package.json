{
    "name": "vsduo-auth",
    "displayName": "VSDuo Auth",
    "description": "Manage Duo devices and approve Duo push requests from VS Code with VSDuo.",
    "version": "0.2.3",
    "publisher": "thisisamirv",
    "icon": "media/icon.png",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/thisisamirv/VSDuo.git"
    },
    "homepage": "https://github.com/thisisamirv/VSDuo",
    "bugs": {
        "url": "https://github.com/thisisamirv/VSDuo/issues"
    },
    "keywords": [
        "duo",
        "2fa",
        "mfa",
        "totp",
        "authentication",
        "security"
    ],
    "galleryBanner": {
        "color": "#3B88C3",
        "theme": "light"
    },
    "files": [
        "dist",
        "media",
        "node_modules",
        "README.md",
        "LICENSE",
        "package.json"
    ],
    "engines": {
        "vscode": "^1.99.0"
    },
    "extensionKind": [
        "ui"
    ],
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:opensshremotes.openEmptyWindow",
        "onCommand:opensshremotes.openEmptyWindowInCurrentWindow",
        "onCommand:opensshremotes.openEmptyWindowOnCurrentHost",
        "onCommand:remote-internal.openRemoteSshTarget"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "VSDuo",
            "properties": {
                "vsduo.refreshIntervalSeconds": {
                    "type": "number",
                    "default": 15,
                    "minimum": 5,
                    "description": "How often the extension refreshes pending Duo transactions for the active device."
                },
                "vsduo.remoteHelperPort": {
                    "type": "number",
                    "default": 47631,
                    "minimum": 1024,
                    "maximum": 65535,
                    "description": "Localhost port used by the VSDuo Remote SSH helper browser page."
                },
                "vsduo.remoteHelperAutoStart": {
                    "type": "string",
                    "default": "backgroundAndOpen",
                    "enum": [
                        "off",
                        "background",
                        "backgroundAndOpen"
                    ],
                    "markdownEnumDescriptions": [
                        "Do not auto-start the Remote SSH helper during a VSDuo SSH connect flow.",
                        "Start the Remote SSH helper in the background when VSDuo connects the current window to an SSH host. If the helper is not already running, VSDuo still opens the helper page once so it is available for the pending Duo prompt.",
                        "Start the Remote SSH helper during a VSDuo SSH connect flow and always open its browser page."
                    ],
                    "description": "Controls whether VSDuo starts the Remote SSH helper automatically when you use VSDuo to connect the current window to an SSH host."
                }
            }
        },
        "commands": [
            {
                "command": "vsduo.addDevice",
                "title": "VSDuo: Add Device"
            },
            {
                "command": "vsduo.refreshTransactions",
                "title": "VSDuo: Refresh Transactions"
            },
            {
                "command": "vsduo.refreshHosts",
                "title": "VSDuo: Refresh Hosts"
            },
            {
                "command": "vsduo.startRemoteHelper",
                "title": "VSDuo: Start Remote SSH Helper"
            },
            {
                "command": "vsduo.connectCurrentWindowToSshHost",
                "title": "VSDuo: Connect Current Window to SSH Host"
            },
            {
                "command": "vsduo.openRemoteHelper",
                "title": "VSDuo: Open Remote SSH Helper"
            },
            {
                "command": "vsduo.stopRemoteHelper",
                "title": "VSDuo: Stop Remote SSH Helper"
            },
            {
                "command": "vsduo.setActiveDevice",
                "title": "VSDuo: Set Active Device"
            },
            {
                "command": "vsduo.renameDevice",
                "title": "VSDuo: Rename Device"
            },
            {
                "command": "vsduo.removeDevice",
                "title": "VSDuo: Remove Device"
            },
            {
                "command": "vsduo.approveTransaction",
                "title": "VSDuo: Approve Transaction"
            },
            {
                "command": "vsduo.denyTransaction",
                "title": "VSDuo: Deny Transaction"
            },
            {
                "command": "vsduo.copyTotp",
                "title": "VSDuo: Copy TOTP"
            },
            {
                "command": "vsduo.importData",
                "title": "VSDuo: Import Data"
            },
            {
                "command": "vsduo.exportData",
                "title": "VSDuo: Export Data"
            },
            {
                "command": "vsduo.exportTotpUris",
                "title": "VSDuo: Export TOTP URIs"
            },
            {
                "command": "vsduo.clearData",
                "title": "VSDuo: Clear Data"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "vsduo",
                    "title": "VSDuo",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "vsduo": [
                {
                    "id": "vsduo.devices",
                    "name": "Devices",
                    "icon": "media/icon.svg"
                },
                {
                    "id": "vsduo.transactions",
                    "name": "Pending Transactions",
                    "icon": "media/icon.svg"
                },
                {
                    "id": "vsduo.hosts",
                    "name": "Hosts",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "vsduo.addDevice",
                    "when": "view == vsduo.devices",
                    "group": "navigation"
                },
                {
                    "command": "vsduo.refreshTransactions",
                    "when": "view == vsduo.transactions",
                    "group": "navigation"
                },
                {
                    "command": "vsduo.refreshHosts",
                    "when": "view == vsduo.hosts",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "vsduo.setActiveDevice",
                    "when": "view == vsduo.devices && viewItem == vsduo.device",
                    "group": "inline"
                },
                {
                    "command": "vsduo.setActiveDevice",
                    "when": "view == vsduo.devices && viewItem == vsduo.deviceHasTotp",
                    "group": "inline"
                },
                {
                    "command": "vsduo.copyTotp",
                    "when": "view == vsduo.devices && viewItem == vsduo.deviceHasTotp",
                    "group": "inline"
                },
                {
                    "command": "vsduo.renameDevice",
                    "when": "view == vsduo.devices && viewItem == vsduo.device",
                    "group": "navigation@1"
                },
                {
                    "command": "vsduo.renameDevice",
                    "when": "view == vsduo.devices && viewItem == vsduo.deviceHasTotp",
                    "group": "navigation@1"
                },
                {
                    "command": "vsduo.removeDevice",
                    "when": "view == vsduo.devices && viewItem == vsduo.device",
                    "group": "navigation@2"
                },
                {
                    "command": "vsduo.removeDevice",
                    "when": "view == vsduo.devices && viewItem == vsduo.deviceHasTotp",
                    "group": "navigation@2"
                },
                {
                    "command": "vsduo.approveTransaction",
                    "when": "view == vsduo.transactions && viewItem == vsduo.transaction",
                    "group": "inline"
                },
                {
                    "command": "vsduo.denyTransaction",
                    "when": "view == vsduo.transactions && viewItem == vsduo.transaction",
                    "group": "inline@2"
                },
                {
                    "command": "vsduo.connectCurrentWindowToSshHost",
                    "when": "view == vsduo.hosts && viewItem == vsduo.host",
                    "group": "inline"
                }
            ],
            "commandPalette": [
                {
                    "command": "vsduo.addDevice"
                },
                {
                    "command": "vsduo.refreshTransactions"
                },
                {
                    "command": "vsduo.refreshHosts"
                },
                {
                    "command": "vsduo.startRemoteHelper"
                },
                {
                    "command": "vsduo.connectCurrentWindowToSshHost"
                },
                {
                    "command": "vsduo.openRemoteHelper"
                },
                {
                    "command": "vsduo.stopRemoteHelper"
                },
                {
                    "command": "vsduo.setActiveDevice"
                },
                {
                    "command": "vsduo.renameDevice"
                },
                {
                    "command": "vsduo.removeDevice"
                },
                {
                    "command": "vsduo.importData"
                },
                {
                    "command": "vsduo.exportData"
                },
                {
                    "command": "vsduo.exportTotpUris"
                },
                {
                    "command": "vsduo.clearData"
                }
            ]
        }
    },
    "scripts": {
        "build": "tsc -p ./tsconfig.json",
        "test": "node --import tsx --test tests/**/*.test.ts",
        "watch": "tsc -w -p ./tsconfig.json",
        "vscode:prepublish": "npm run build",
        "package": "npm run build && node scripts/package-vsix.cjs",
        "package:marketplace": "npm run build && npx -y @vscode/vsce@3.9.1 package",
        "publish:marketplace": "npm run build && npx -y @vscode/vsce@3.9.1 publish"
    },
    "dependencies": {
        "otplib": "^13.4.0",
        "ssh-config": "^5.1.0"
    },
    "devDependencies": {
        "@types/node": "^25.7",
        "@types/vscode": "^1.118",
        "tsx": "^4.21",
        "typescript": "^6.0",
        "yazl": "^3.3"
    }
}